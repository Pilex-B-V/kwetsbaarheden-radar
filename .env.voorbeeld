# Instellingen van de radar. Kopieer dit bestand naar .env en vul in wat je
# gebruikt. Het bestand .env blijft op je computer: het staat in .gitignore en
# gaat nooit mee naar GitHub. Rol je de radar uit in GitHub Actions, dan zet
# de opdracht "gh secret set -f .env" de waarden over als secrets.
#
# Laat een regel leeg of zet er een # voor als je hem niet gebruikt.

# ── De mail via Outlook (zie docs/outlook-instellen.md) ──────────────────
RADAR_TENANT_ID=
RADAR_CLIENT_ID=
RADAR_CLIENT_SECRET=
RADAR_MAIL_VAN=
RADAR_MAIL_AAN=

# ── Of: de mail als bericht naar een webhook, in plaats van Outlook ──────
# RADAR_WEBHOOK_URL=

# ── Lockfiles ophalen uit afgeschermde repositories op GitHub ────────────
# Een fine-grained token dat alleen Contents mag lezen (README, onder Het leestoken voor GitHub).
RADAR_GITHUB_TOKEN=

# ── Optioneel ────────────────────────────────────────────────────────────
# Een gratis sleutel van NVD maakt het nalopen van platformonderdelen sneller.
# NVD_API_KEY=
# Alleen een mail als er iets nieuws is (ons advies: laat dit uit).
# RADAR_ALLEEN_BIJ_NIEUWS=ja
# De tijdzone voor de datum in de mail.
# RADAR_TIJDZONE=Europe/Amsterdam
